{%- liquid
  assign s = section.settings
  assign has_photo = false
  if s.image != blank or s.image_url != blank
    assign has_photo = true
  endif
  assign alt = s.image_alt
  if alt == blank
    assign alt = s.image.alt
  endif
-%}

<header
  class="bsr-hero"
  style="
    --bsr-hero-shift: {{ s.photo_shift }}px;
    --bsr-hero-focus: {{ s.focus_x }}% {{ s.focus_y }}%;
    --bsr-hero-focus-mobile: {{ s.focus_x_mobile }}% {{ s.focus_y_mobile }}%;
    min-height: {{ s.height }}px;
  "
>
  <div class="bsr-hero__media"{% unless has_photo %} data-missing{% endunless %}>
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 1900, 2400, 3000',
          alt: alt
      }}
    {%- elsif s.image_url != blank -%}
      <img src="{{ s.image_url }}" alt="{{ alt | escape }}" loading="eager" fetchpriority="high">
    {%- endif -%}
    <div class="bsr-hero__fallback">Add a hero photo in the theme editor</div>
  </div>

  <div class="bsr-hero__inner">
    <div class="bsr-hero__panel">
      {%- if s.kicker != blank -%}
        <span class="bsr-hero__kicker">{{ s.kicker }}</span>
      {%- endif -%}

      <h1 class="bsr-display">
        {{ s.heading }}
        {%- if s.heading_accent != blank -%}
          <br><span class="bsr-hero__out">{{ s.heading_accent }}</span>
        {%- endif -%}
      </h1>

      {%- if s.lead != blank -%}
        <p class="bsr-hero__lead">{{ s.lead }}</p>
      {%- endif -%}

      {%- if s.button_1_label != blank or s.button_2_label != blank -%}
        <div class="bsr-hero__btns">
          {%- if s.button_1_label != blank -%}
            <a class="bsr-btn bsr-btn--orange" href="{{ s.button_1_link | default: '#' }}">
              {{- s.button_1_label -}}
            </a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a class="bsr-btn bsr-btn--paper" href="{{ s.button_2_link | default: '#' }}">
              {{- s.button_2_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.note != blank -%}
        <p class="bsr-hero__note">{{ s.note }}</p>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Retro hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photo",
      "info": "Upload or pick from Content → Files. Leave empty to use a URL instead."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "…or paste an image URL",
      "info": "Only used when no photo is picked above. Must be a direct link to the image file."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "info": "Describe the photo for screen readers and search.",
      "default": "Kid in ski gear on the mountain"
    },
    {
      "type": "header",
      "content": "Framing"
    },
    {
      "type": "paragraph",
      "content": "Use these if the copy panel covers your subject. Slide right pushes whoever is in the middle of the photo away from the panel."
    },
    {
      "type": "range",
      "id": "photo_shift",
      "min": 0,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Slide photo right (desktop)",
      "default": 140
    },
    {
      "type": "range",
      "id": "focus_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Crop from left",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Crop from top",
      "default": 35
    },
    {
      "type": "range",
      "id": "height",
      "min": 380,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Minimum height",
      "default": 560
    },
    {
      "type": "header",
      "content": "Framing on mobile"
    },
    {
      "type": "range",
      "id": "focus_x_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Crop from left",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Crop from top",
      "default": 30
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "★ Kids Season Leases · Winter 2026–27"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One price."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Second line (accent colour)",
      "default": "All winter."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Paragraph",
      "default": "Skis, boots and poles for the whole season — fitted properly, swapped free when they hit a growth spurt. Because nobody wants to rent gear at the mountain at 7am. Again."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Paid in full online · Fitting appointment booked after checkout"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button",
      "default": "Reserve a Season Set"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button",
      "default": "How It Works"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Retro hero"
    }
  ]
}
{% endschema %}
