<section class="bsr-section">
  <div class="bsr-wrap">
    {%- if section.settings.pill != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="bsr-sechead">
        {%- if section.settings.pill != blank -%}
          <span class="bsr-pill">{{ section.settings.pill }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bsr-display">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bsr-tickets">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="bsr-ticket{% if b.featured %} bsr-ticket--hot{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.flag != blank -%}
            <span class="bsr-flag">{{ b.flag }}</span>
          {%- endif -%}

          <div class="bsr-ticket__top">
            {%- if b.label != blank -%}
              <div class="bsr-ticket__no">{{ b.label }}</div>
            {%- endif -%}
            <h3>{{ b.title }}</h3>
            {%- if b.subtitle != blank -%}
              <p class="bsr-ticket__sub">{{ b.subtitle }}</p>
            {%- endif -%}
            <span class="bsr-notch bsr-notch--l"></span>
            <span class="bsr-notch bsr-notch--r"></span>
          </div>

          <div class="bsr-ticket__body">
            {%- assign features = b.features | newline_to_br | split: '<br />' -%}
            {%- if features.size > 0 -%}
              <ul>
                {%- for feature in features -%}
                  {%- assign line = feature | strip -%}
                  {%- if line != blank -%}
                    <li>{{ line }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div>
              {%- if b.product != blank -%}
                <span class="bsr-amt">{{ b.product.price | money }}</span>
              {%- else -%}
                <span class="bsr-amt">{{ b.price_text }}</span>
              {%- endif -%}
              {%- if b.price_suffix != blank -%}
                <span class="bsr-per">{{ b.price_suffix }}</span>
              {%- endif -%}
            </div>

            {%- if b.product != blank -%}
              {%- form 'product', b.product, class: 'bsr-ticket__form' -%}
                <input type="hidden" name="id" value="{{ b.product.selected_or_first_available_variant.id }}">
                <button
                  type="submit"
                  class="bsr-btn {% if b.featured %}bsr-btn--orange{% else %}bsr-btn--paper{% endif %}"
                  {% unless b.product.available %}disabled{% endunless %}
                >
                  {% if b.product.available %}{{ b.button_label }}{% else %}Sold out{% endif %}
                </button>
              {%- endform -%}
            {%- elsif b.button_label != blank -%}
              <a
                class="bsr-btn {% if b.featured %}bsr-btn--orange{% else %}bsr-btn--paper{% endif %}"
                href="{{ b.button_link | default: '#' }}"
              >
                {{- b.button_label -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retro packages",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "pill", "label": "Eyebrow", "default": "★ The Packages" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grab your season pass to not renting twice." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Every rental runs the full winter and includes a free size exchange if your kid outgrows their setup halfway through." }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        { "type": "checkbox", "id": "featured", "label": "Highlight this one", "default": false },
        { "type": "text", "id": "flag", "label": "Corner flag", "info": "Leave blank for none" },
        { "type": "text", "id": "label", "label": "Small label", "default": "Rental No. 01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Full Season Package" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Skis · Boots · Poles" },
        { "type": "textarea", "id": "features", "label": "Included", "info": "One per line", "default": "Junior skis sized to height & ability\nBoots fitted in store\nPoles included\nFree mid-season size exchange\nBindings tested & set to spec" },
        { "type": "header", "content": "Price and button" },
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. If set, the real price and an add-to-cart button are used." },
        { "type": "text", "id": "price_text", "label": "Price if no product is picked", "default": "Price TBD" },
        { "type": "text", "id": "price_suffix", "label": "Price suffix", "default": "/ season" },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Reserve This" },
        { "type": "url", "id": "button_link", "label": "Button link", "info": "Ignored when a product is picked" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Retro packages",
      "blocks": [
        { "type": "package", "settings": { "featured": true, "flag": "Most popular", "label": "Rental No. 01", "title": "Full Season Package", "subtitle": "Skis · Boots · Poles" } },
        { "type": "package", "settings": { "label": "Rental No. 02", "title": "Skis & Boots", "subtitle": "Already have poles?", "features": "Junior skis sized to height & ability\nBoots fitted in store\nFree mid-season size exchange\nBindings tested & set to spec" } },
        { "type": "package", "settings": { "label": "Add-On", "title": "Season Helmet", "subtitle": "Add to any rental", "features": "Adjustable junior fit\nCertified & sanitized\nSwaps with the size exchange", "button_label": "Add A Helmet" } }
      ]
    }
  ]
}
{% endschema %}
