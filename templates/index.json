    "retro_faq": {
      "type": "retro-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "What if my kid grows mid-season?",
            "answer": "Bring the setup in and we'll re-fit them into the next size up. Included in every rental."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "How long is the season?",
            "answer": "From pickup through the posted spring return date. Exact dates are confirmed in your reservation email."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Do I need to know their boot size?",
            "answer": "Nope. Give us your best guess online \u2014 we measure and fit properly at the appointment."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "question": "What if the gear gets damaged?",
            "answer": "Normal wear from a winter of skiing is expected. Damage terms are spelled out in the rental agreement you sign at fitting."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "question": "Can I rent for more than one kid?",
            "answer": "Yes \u2014 add a package per child and enter each kid's fitting details separately at checkout."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "question": "When do daily rentals open?",
            "answer": "We're building them now. Join the notify list and you'll hear the moment booking goes live."
          }
        }
      },
