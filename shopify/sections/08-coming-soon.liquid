<section class="bsr-soon bsr-section" id="soon">
  <div class="bsr-wrap bsr-soon__grid">
    <div>
      <span class="bsr-pill bsr-pill--mustard">★ Coming Soon</span>
      <h2 class="bsr-display">Daily rentals are<br><span class="bsr-soon__hl">on the way.</span></h2>
      <p class="bsr-soon__copy">Just need gear for a Saturday on Hood? Day and weekend rentals with online
         date booking are coming this winter. Get on the list and you'll book first.</p>
      <div class="bsr-signup">
        <div class="bsr-inp">you@email.com</div>
        <a class="bsr-btn bsr-btn--mustard" href="#">Notify Me</a>
      </div>
    </div>
    <div class="bsr-soon__list">
      <div class="bsr-soon__item"><b>Adult ski packages</b><span>Coming soon</span></div>
      <div class="bsr-soon__item"><b>Snowboard &amp; boots</b><span>Coming soon</span></div>
      <div class="bsr-soon__item"><b>Jackets, pants &amp; goggles</b><span>Coming soon</span></div>
      <div class="bsr-soon__item"><b>Weekend multi-day rates</b><span>Coming soon</span></div>
    </div>
  </div>
</section>
