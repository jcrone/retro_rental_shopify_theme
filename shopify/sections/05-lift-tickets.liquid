{%- comment -%}
  Package cards as lift tickets

  Online Store → Themes → Customize → Add section → Custom Liquid,
  then paste everything below this comment.

  Needs shopify/custom-css.css in Theme settings → Custom CSS.
  Generated from src/mockup.html by build.js — edit that, not this.
{%- endcomment -%}

<section class="bsr-section" id="tickets">
  <div class="bsr-wrap">
    <div class="bsr-sechead">
      <span class="bsr-pill">★ The Packages</span>
      <h2 class="bsr-display">Grab your season pass<br>to not renting twice.</h2>
      <p>Every lease runs the full winter and includes a free size exchange if your
         kid outgrows their setup halfway through.</p>
    </div>

    <div class="bsr-tickets">
      <div class="bsr-ticket bsr-ticket--hot">
        <span class="bsr-flag">Most popular</span>
        <div class="bsr-ticket__top">
          <div class="bsr-ticket__no">Lease No. 01</div>
          <h3>Full Season<br>Package</h3>
          <p class="bsr-ticket__sub">Skis · Boots · Poles</p>
          <span class="bsr-notch bsr-notch--l"></span><span class="bsr-notch bsr-notch--r"></span>
        </div>
        <div class="bsr-ticket__body">
          <ul>
            <li>Junior skis sized to height &amp; ability</li>
            <li>Boots fitted in store</li>
            <li>Poles included</li>
            <li>Free mid-season size exchange</li>
            <li>Bindings tested &amp; set to spec</li>
          </ul>
          <div><span class="bsr-amt">Price TBD</span> <span class="bsr-per">/ season</span></div>
          <a class="bsr-btn bsr-btn--orange" href="#">Reserve This</a>
        </div>
      </div>

      <div class="bsr-ticket">
        <div class="bsr-ticket__top">
          <div class="bsr-ticket__no">Lease No. 02</div>
          <h3>Skis &amp;<br>Boots</h3>
          <p class="bsr-ticket__sub">Already have poles?</p>
          <span class="bsr-notch bsr-notch--l"></span><span class="bsr-notch bsr-notch--r"></span>
        </div>
        <div class="bsr-ticket__body">
          <ul>
            <li>Junior skis sized to height &amp; ability</li>
            <li>Boots fitted in store</li>
            <li>Free mid-season size exchange</li>
            <li>Bindings tested &amp; set to spec</li>
          </ul>
          <div><span class="bsr-amt">Price TBD</span> <span class="bsr-per">/ season</span></div>
          <a class="bsr-btn bsr-btn--paper" href="#">Reserve This</a>
        </div>
      </div>

      <div class="bsr-ticket">
        <div class="bsr-ticket__top">
          <div class="bsr-ticket__no">Add-On</div>
          <h3>Season<br>Helmet</h3>
          <p class="bsr-ticket__sub">Add to any lease</p>
          <span class="bsr-notch bsr-notch--l"></span><span class="bsr-notch bsr-notch--r"></span>
        </div>
        <div class="bsr-ticket__body">
          <ul>
            <li>Adjustable junior fit</li>
            <li>Certified &amp; sanitized</li>
            <li>Swaps with the size exchange</li>
          </ul>
          <div><span class="bsr-amt">Price TBD</span> <span class="bsr-per">/ season</span></div>
          <a class="bsr-btn bsr-btn--paper" href="#">Add A Helmet</a>
        </div>
      </div>
    </div>
  </div>
</section>
