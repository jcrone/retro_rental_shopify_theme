<section class="bsr-soon bsr-section">
  <div class="bsr-wrap bsr-soon__grid">
    <div>
      {%- if section.settings.pill != blank -%}
        <span class="bsr-pill bsr-pill--mustard">{{ section.settings.pill }}</span>
      {%- endif -%}
      <h2 class="bsr-display">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <br><span class="bsr-soon__hl">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="bsr-soon__copy">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.show_signup -%}
        {%- form 'customer', class: 'bsr-signup' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="RetroSoonEmail-{{ section.id }}">Email</label>
          <input
            id="RetroSoonEmail-{{ section.id }}"
            class="bsr-inp"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="you@email.com"
            required
          >
          <button type="submit" class="bsr-btn bsr-btn--mustard">{{ section.settings.signup_label }}</button>
          {%- if form.posted_successfully? -%}
            <p class="bsr-soon__copy">Thanks — you're on the list.</p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>

    <div class="bsr-soon__list">
      {%- for block in section.blocks -%}
        <div class="bsr-soon__item" {{ block.shopify_attributes }}>
          <b>{{ block.settings.title }}</b>
          <span>{{ block.settings.tag }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retro coming soon",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "pill", "label": "Eyebrow", "default": "★ Coming Soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Daily rentals are" },
    { "type": "text", "id": "heading_accent", "label": "Second line (accent colour)", "default": "on the way." },
    { "type": "textarea", "id": "text", "label": "Copy", "default": "Just need gear for a Saturday on Hood? Day and weekend rentals with online date booking are coming this winter. Get on the list and you'll book first." },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "text", "id": "signup_label", "label": "Signup button", "default": "Notify Me" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Adult ski packages" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Coming soon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Retro coming soon",
      "blocks": [
        { "type": "item", "settings": { "title": "Adult ski packages" } },
        { "type": "item", "settings": { "title": "Snowboard & boots" } },
        { "type": "item", "settings": { "title": "Jackets, pants & goggles" } },
        { "type": "item", "settings": { "title": "Weekend multi-day rates" } }
      ]
    }
  ]
}
{% endschema %}
